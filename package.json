{
  "name": "botak-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "source:import": "tsx scripts/import-source.ts && tsx scripts/create-curriculum.ts && npm run content",
    "content": "tsx scripts/compile-content.ts",
    "runtime": "node scripts/sync-runtime.mjs",
    "predev": "npm run content && npm run runtime",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run content && npm run runtime && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check": "tsc -b"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-python": "^6.2.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "blockly": "^12.0.0",
    "dompurify": "^3.2.0",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.0",
    "pyodide": "0.27.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
